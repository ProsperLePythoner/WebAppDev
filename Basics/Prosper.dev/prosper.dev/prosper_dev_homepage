<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homepage</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              slateBase: '#0f172a',
              slateCard: '#1e293b',
              accentSky: '#38bdf8',
              accentHover: '#0284c7',
            }
          }
        }
      }
    </script>
    <style>
      .cursor {
        animation: blink 0.8s infinite;
      }
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }
    </style>
</head>
<body class="bg-slateBase text-slate-100 font-sans leading-relaxed">

    <!-- Sticky Navbar -->
    <nav class="sticky top-0 z-50 flex items-center justify-between px-6 py-4 md:px-12 bg-slateBase/85 backdrop-blur-md border-b border-slate-700/60">
        <a href="homepage.html" class="text-2xl font-bold text-accentSky tracking-wide">Prosper.dev</a>
        <ul class="flex items-center gap-6">
            <li><a href="#" class="text-accentSky font-medium transition-colors hover:text-accentSky">Home</a></li>
            <li><a href="#about" class="text-slate-400 font-medium transition-colors hover:text-accentSky">About Us</a></li>
            <li><a href="#services" class="text-slate-400 font-medium transition-colors hover:text-accentSky">Services</a></li>
            <li><a href="#contact" class="text-slate-400 font-medium transition-colors hover:text-accentSky">Contact</a></li>
            <li><a href="#" class="text-slate-400 font-medium transition-colors hover:text-accentSky">Logout</a></li>
        </ul>
    </nav>

    <main>
        <!-- Hero Section -->
        <section class="relative min-h-[70vh] flex items-center justify-center text-center px-4 py-16 bg-cover bg-center" style="background-image: linear-gradient(rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.9)), url('https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1600&q=80');">
            <div class="max-w-3xl">
                <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">
                    Welcome to 
                    <span id="typewriter" class="text-accentSky"></span><span class="cursor text-accentSky font-light ml-1">|</span>
                </h1>
                <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto">
                    Architecting scalable digital solutions and turning bold ideas into seamless web experiences.
                </p>
            </div>
        </section>

        <!-- About Section -->
        <section id="about" class="py-16 px-6 md:px-12 max-w-4xl mx-auto text-center">
            <h2 class="text-3xl font-bold text-accentSky mb-4">About Us</h2>
            <p class="text-slate-300 text-lg">
                Welcome to Prosper.dev. We are a team of forward-thinking developers and designers dedicated to crafting high-performance digital products that drive impact.
            </p>
        </section>

        <!-- Services Section -->
        <section id="services" class="py-16 px-6 md:px-12 max-w-6xl mx-auto">
            <h2 class="text-3xl font-bold text-accentSky text-center mb-10">What We Offer</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                
                <div class="bg-slateCard p-6 rounded-lg border border-slate-700/60 hover:-translate-y-1 hover:border-accentSky transition-all duration-300">
                    <h3 class="text-xl font-semibold text-white mb-2">Web Development</h3>
                    <p class="text-slate-400 text-sm">Building fast, accessible, and responsive websites engineered for optimal performance and seamless user navigation.</p>
                </div>

                <div class="bg-slateCard p-6 rounded-lg border border-slate-700/60 hover:-translate-y-1 hover:border-accentSky transition-all duration-300">
                    <h3 class="text-xl font-semibold text-white mb-2">Mobile App Development</h3>
                    <p class="text-slate-400 text-sm">Designing cross-platform mobile applications that combine intuitive interfaces with rich, reliable features.</p>
                </div>

                <div class="bg-slateCard p-6 rounded-lg border border-slate-700/60 hover:-translate-y-1 hover:border-accentSky transition-all duration-300">
                    <h3 class="text-xl font-semibold text-white mb-2">Digital Marketing</h3>
                    <p class="text-slate-400 text-sm">Executing data-driven strategies to amplify your brand's online presence, engage audiences, and scale reach.</p>
                </div>

                <div class="bg-slateCard p-6 rounded-lg border border-slate-700/60 hover:-translate-y-1 hover:border-accentSky transition-all duration-300">
                    <h3 class="text-xl font-semibold text-white mb-2">UI/UX Design</h3>
                    <p class="text-slate-400 text-sm">Crafting sleek, user-centric interfaces that turn complex interactions into effortless digital journeys.</p>
                </div>

            </div>
        </section>

        <!-- Contact Section -->
        <section id="contact" class="py-16 px-6 md:px-12 max-w-2xl mx-auto">
            <h2 class="text-3xl font-bold text-accentSky text-center mb-2">Contact Us</h2>
            <p class="text-slate-400 text-center mb-8">
                Have a project in mind or want to collaborate? Send a message through the form below or reach out directly across any of our channels.
            </p>

            <form action="" method="post" class="space-y-5">
                <div class="flex flex-col">
                    <label for="name" class="text-sm font-medium mb-1">Name:</label>
                    <input type="text" id="name" name="name" required class="bg-slateCard border border-slate-700 rounded-md p-3 text-white focus:outline-none focus:border-accentSky transition-colors">
                </div>

                <div class="flex flex-col">
                    <label for="email" class="text-sm font-medium mb-1">Email:</label>
                    <input type="email" id="email" name="email" required class="bg-slateCard border border-slate-700 rounded-md p-3 text-white focus:outline-none focus:border-accentSky transition-colors">
                </div>

                <div class="flex flex-col">
                    <label for="message" class="text-sm font-medium mb-1">Message:</label>
                    <textarea id="message" name="message" rows="4" required class="bg-slateCard border border-slate-700 rounded-md p-3 text-white focus:outline-none focus:border-accentSky transition-colors"></textarea>
                </div>

                <button type="submit" class="w-full bg-accentSky hover:bg-accentHover text-slateBase font-semibold py-3 px-6 rounded-md transition-colors">
                    Send Message
                </button>
            </form>

            <div class="mt-12 text-center">
                <p class="text-slate-400 mb-4">Connect with us directly across social platforms or via email:</p>
                <ul class="flex justify-center flex-wrap gap-6">
                    <li><a href="#" class="text-accentSky hover:underline transition-colors">Facebook</a></li>
                    <li><a href="#" class="text-accentSky hover:underline transition-colors">Twitter</a></li>
                    <li><a href="#" class="text-accentSky hover:underline transition-colors">LinkedIn</a></li>
                    <li><a href="mailto:prosper.dev@email.com" class="text-accentSky hover:underline transition-colors">Gmail</a></li>
                </ul>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="py-8 text-center text-slate-400 border-t border-slate-800 text-sm">
        <p>&copy; 2026 Prosper.dev. All rights reserved.</p>
    </footer>

    <script src="typewriter.js" defer></script>
</body>
</html>